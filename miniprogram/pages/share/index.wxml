<view class="page share-page page-enter" style="padding-top: {{navSpacer}}rpx">
  <custom-nav show-back show-credit="{{false}}"></custom-nav>

  <view wx:if="{{loading}}" class="share-loading">
    <view class="loading-flower"></view>
    <view>正在打开作品</view>
  </view>

  <view wx:elif="{{share}}" class="share-body">
    <view class="share-heading">
      <view class="share-kicker">XIANGHUI MOMENT</view>
      <view class="share-title">{{shareTitle}}</view>
      <view class="share-meta">{{share.templateName}} · 来自花漾相绘</view>
    </view>

    <!-- 含原图：作品大图为主，原图缩略参照 -->
    <block wx:if="{{share.showOriginals && comparePairs.length}}">
      <view class="compare-list">
        <view wx:for="{{comparePairs}}" wx:key="id" class="compare-card">
          <view
            class="compare-hero"
            data-url="{{item.result.url}}"
            data-kind="result"
            bindtap="previewCompare"
          >
            <image
              class="compare-hero__image"
              src="{{item.result.thumbUrl || item.result.url}}"
              mode="widthFix"
              lazy-load
            ></image>
          </view>

          <view
            wx:if="{{item.original}}"
            class="compare-origin"
            data-url="{{item.original.url}}"
            data-kind="original"
            bindtap="previewCompare"
            hover-class="compare-origin--hover"
          >
            <image
              class="compare-origin__thumb"
              src="{{item.original.thumbUrl || item.original.url}}"
              mode="aspectFill"
              lazy-load
            ></image>
            <view class="compare-origin__copy">
              <text class="compare-origin__label">原图参照</text>
              <text class="compare-origin__hint">点按查看大图</text>
            </view>
            <text class="compare-origin__arrow">›</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 仅效果图 -->
    <block wx:else>
      <view class="shared-results">
        <view wx:for="{{share.results}}" wx:key="id" class="shared-result">
          <image src="{{item.thumbUrl || item.url}}" mode="widthFix" data-url="{{item.url}}" lazy-load bindtap="preview"></image>
        </view>
      </view>
    </block>

    <view class="share-convert">
      <view class="share-convert__title">喜欢这个风格？</view>
      <view class="share-convert__desc">
        <text wx:if="{{welcomeCredits > 0}}">登录可领 {{welcomeCredits}} 积分新用户礼遇，</text>
        <text>用同款风格立刻开画</text>
      </view>
    </view>
  </view>

  <view wx:if="{{share && !loading}}" class="share-dock">
    <button class="share-dock__save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveAll">保存全部</button>
    <button class="share-dock__create" loading="{{creating}}" disabled="{{creating}}" bindtap="goCreate">
      {{welcomeCredits > 0 ? '免费去创作' : '我也来试试'}}
    </button>
  </view>
</view>
