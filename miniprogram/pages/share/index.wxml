<view class="page share-page page-enter" style="padding-top: {{navSpacer}}rpx">
  <custom-nav show-back show-credit="{{false}}"></custom-nav>

  <view wx:if="{{loading}}" class="share-loading">
    <view class="loading-flower"></view>
    <view>正在打开作品</view>
  </view>

  <view wx:elif="{{share}}" class="share-body">
    <view class="share-heading">
      <view class="share-kicker">XIANGHUI MOMENT</view>
      <view class="share-title">{{shareTitle}}</view>
      <view class="share-meta">{{share.templateName}} · 来自花漾相绘</view>
    </view>

    <view class="shared-results">
      <view wx:for="{{share.results}}" wx:key="id" class="shared-result">
        <image src="{{item.thumbUrl || item.url}}" mode="widthFix" data-url="{{item.url}}" lazy-load bindtap="preview"></image>
        <view class="shared-actions">
          <button class="shared-actions__save" data-url="{{item.url}}" bindtap="saveImage" loading="{{saving}}">保存图片</button>
          <button class="shared-actions__create" bindtap="goCreate">我也来试试</button>
        </view>
      </view>
    </view>

    <view class="share-note">登录创作可获得新用户礼遇；好友邀请也可能获得积分</view>
  </view>
</view>
