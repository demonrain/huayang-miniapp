.job-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
}

/* Room for fixed showcase dock */
.job-page--showcase {
  padding-bottom: calc(env(safe-area-inset-bottom) + 140rpx);
}

.job-page--owner-dock {
  padding-bottom: calc(env(safe-area-inset-bottom) + 160rpx);
}

.job-meta {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  box-shadow: 0 10rpx 26rpx rgba(108, 82, 92, 0.05);
}

.job-meta--showcase .job-meta__value {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.job-meta__author {
  cursor: pointer;
}

.job-meta__author--hover {
  background: #fff8f9;
}

.job-meta__author-name {
  max-width: 100%;
}

.author-card-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  background: rgba(42, 36, 40, 0.48);
}

.author-card {
  width: 100%;
  max-width: 560rpx;
  padding: 32rpx 28rpx 24rpx;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 28rpx 80rpx rgba(55, 39, 45, 0.22);
  animation: author-card-pop 0.22s ease-out;
}

@keyframes author-card-pop {
  from {
    opacity: 0;
    transform: translateY(16rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.author-card__head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.author-card__avatar {
  flex: none;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #f0e8ea;
  border: 3rpx solid #f7e8ec;
  box-shadow: 0 8rpx 24rpx rgba(108, 81, 92, 0.1);
}

.author-card__avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c56f60;
  font-size: 48rpx;
  font-weight: 700;
  background: #fff5f7;
}

.author-card__identity {
  width: 100%;
  min-width: 0;
}

.author-card__name {
  display: block;
  overflow: hidden;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.author-card__hint {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.author-card__bio-label {
  margin-bottom: 10rpx;
  color: #c56f60;
  font-size: 20rpx;
  font-weight: 650;
}

.author-card__bio {
  min-height: 88rpx;
  max-height: 280rpx;
  overflow-y: auto;
  padding: 18rpx 18rpx;
  background: #fff8f9;
  border: 2rpx solid #f7e8ec;
  border-radius: 14rpx;
  color: var(--ink);
  font-size: 26rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.author-card__bio.is-empty {
  color: var(--muted);
}

.author-card__close {
  margin-top: 22rpx;
  width: 100%;
  height: 80rpx !important;
}

.generating {
  margin-top: 24rpx;
  padding: 56rpx 36rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: linear-gradient(165deg, #2f433d 0%, #3d5550 48%, #5a6e68 100%);
  border-radius: 20rpx;
  box-shadow: 0 16rpx 40rpx rgba(47, 67, 61, 0.18);
  color: #fff;
}

.progress-flower {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 28rpx;
  animation: flower-spin 4.5s linear infinite;
}

.progress-petal {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 56rpx;
  height: 80rpx;
  margin-left: -28rpx;
  margin-top: -70rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  transform-origin: 50% 88%;
}

.progress-petal--1 { transform: rotate(0deg); }
.progress-petal--2 { transform: rotate(90deg); }
.progress-petal--3 { transform: rotate(180deg); }
.progress-petal--4 { transform: rotate(270deg); }

.progress-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  width: 40rpx;
  height: 40rpx;
  margin-left: -20rpx;
  margin-top: -20rpx;
  background: var(--yellow);
  border: 6rpx solid #fff;
  border-radius: 50%;
  box-sizing: border-box;
}

.generating-title {
  font-family: "Kaiti SC", "STKaiti", "Songti SC", serif;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
}

.generating-status {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.generating-tip {
  margin-top: 22rpx;
  min-height: 72rpx;
  padding: 0 12rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  line-height: 1.55;
  transition: opacity 0.3s ease;
}

.progress-track {
  width: 78%;
  height: 8rpx;
  margin-top: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
}

.progress-track__bar {
  width: 42%;
  height: 100%;
  background: linear-gradient(90deg, #ffd978, #fff);
  border-radius: 999rpx;
  animation: progress-slide 1.8s ease-in-out infinite;
}

.generating-note {
  margin-top: 28rpx;
  max-width: 520rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
  line-height: 1.6;
}

@keyframes flower-spin {
  to { transform: rotate(360deg); }
}

@keyframes progress-slide {
  0% { transform: translateX(-120%); }
  100% { transform: translateX(280%); }
}

.status-block {
  margin-top: 24rpx;
  min-height: 160rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--mint-soft);
  border: 2rpx solid #d8eee7;
  border-radius: 16rpx;
  color: #44665e;
}

.status-block--succeeded {
  background: var(--pink-soft);
  border-color: #f5dce1;
  color: #76545c;
}

.status-block--failed {
  background: #fff0ed;
  border-color: #f4d6cf;
  color: #8a574d;
}

/* Cute fail card */
.fail-card {
  margin-top: 24rpx;
  padding: 48rpx 36rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: linear-gradient(165deg, #fff8f6 0%, #fff0ed 55%, #fef6f0 100%);
  border: 2rpx solid #f4d6cf;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(138, 87, 77, 0.08);
}

.fail-illus {
  position: relative;
  width: 160rpx;
  height: 140rpx;
  margin-bottom: 12rpx;
}

.fail-flower {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  opacity: 0.92;
}

.fail-petal {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 42rpx;
  height: 58rpx;
  margin-left: -21rpx;
  margin-top: -52rpx;
  background: linear-gradient(180deg, #ffd4dc, #f2a4b1);
  border-radius: 50%;
  transform-origin: 50% 88%;
}

.fail-petal--1 { transform: rotate(0deg); opacity: 0.85; }
.fail-petal--2 { transform: rotate(90deg); background: linear-gradient(180deg, #ffe8c8, #ffb59c); }
.fail-petal--3 { transform: rotate(180deg) scale(0.92); opacity: 0.7; }
.fail-petal--4 { transform: rotate(270deg); background: linear-gradient(180deg, #e8e0f8, #c4b8dc); opacity: 0.8; }

.fail-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  width: 32rpx;
  height: 32rpx;
  margin: -16rpx 0 0 -16rpx;
  background: #ffd978;
  border: 5rpx solid #fff;
  border-radius: 50%;
}

.fail-cloud {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 48rpx;
  height: 28rpx;
  background: rgba(180, 160, 155, 0.25);
  border-radius: 999rpx;
}

.fail-title {
  margin-top: 8rpx;
  color: #7a4f48;
  font-family: "Kaiti SC", "STKaiti", "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 700;
}

.fail-desc {
  margin-top: 14rpx;
  max-width: 520rpx;
  color: #9a6a62;
  font-size: 26rpx;
  line-height: 1.55;
}

.fail-refund {
  margin-top: 18rpx;
  padding: 12rpx 20rpx;
  background: var(--mint-soft);
  border-radius: 999rpx;
  color: var(--green);
  font-size: 22rpx;
  font-weight: 600;
}

.fail-unstable {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  max-width: 560rpx;
  background: #fff8e7;
  border: 2rpx solid #f3ead1;
  border-radius: 12rpx;
  color: #8a7650;
  font-size: 22rpx;
  line-height: 1.55;
}

.job-fail-actions {
  margin-top: 28rpx;
}

.status-index {
  width: 78rpx;
  height: 78rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 8rpx solid rgba(255, 217, 120, 0.72);
  border-radius: 50%;
  color: var(--coral);
  font-size: 20rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(99, 79, 85, 0.08);
}

.status-main {
  min-width: 0;
  flex: 1;
}

.status-title {
  font-size: 34rpx;
  font-weight: 650;
}

.status-sub {
  margin-top: 10rpx;
  color: currentColor;
  opacity: 0.72;
  font-size: 20rpx;
  line-height: 1.55;
}

.job-meta > view {
  min-width: 0;
  padding: 24rpx 10rpx;
  text-align: center;
  border-right: 2rpx solid var(--line);
}

.job-meta > view:last-child { border-right: 0; }
.job-meta > view > text:first-child { display: block; color: var(--muted); font-size: 18rpx; }
.job-meta__value { display: block; margin-top: 7rpx; color: var(--ink) !important; font-size: 22rpx !important; font-weight: 650; }
.job-meta__author .job-meta__author-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.result-item {
  position: relative;
  padding: 10rpx;
  overflow: hidden;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  box-shadow: 0 12rpx 30rpx rgba(110, 83, 94, 0.07);
}

.result-item image {
  width: 100%;
  display: block;
  border-radius: 10rpx;
}

.result-number {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 7rpx 13rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
  color: var(--coral);
  font-size: 18rpx;
  font-weight: 650;
}

.original-section {
  margin-top: 12rpx;
}

.original-section__title {
  margin-top: 28rpx;
}

.original-scroll {
  width: 100%;
  white-space: nowrap;
}

.original-row {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 8rpx;
}

.original-card {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  flex: none;
  overflow: hidden;
  background: #f0e9eb;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  box-shadow: 0 8rpx 18rpx rgba(108, 82, 92, 0.06);
}

.original-card__image {
  display: block;
  width: 100%;
  height: 100%;
}

.original-card__label {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  left: 10rpx;
  padding: 6rpx 8rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 8rpx;
  color: var(--muted);
  font-size: 18rpx;
  text-align: center;
}

.result-actions {
  padding-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.result-actions button {
  height: 64rpx;
  margin: 0;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: var(--mint-soft);
  color: var(--green);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.result-actions button:last-child {
  background: var(--pink-soft);
  color: var(--coral);
}

.result-actions button::after {
  border: 0;
}

.action-icon {
  width: 30rpx;
  height: 30rpx;
  flex: none;
  display: block;
}

/* One row of two equal buttons; cells prevent WeChat button width overflow */
.job-row-actions {
  margin-top: 28rpx;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.job-row-actions--single .job-row-actions__cell {
  flex: 1;
  width: 100%;
  max-width: 100%;
}

.job-row-actions__cell {
  flex: 1;
  width: 0;
  min-width: 0;
}

.job-row-btn {
  width: 100% !important;
  max-width: 100%;
  height: 88rpx !important;
  min-height: 88rpx;
  margin: 0 !important;
  padding: 0 12rpx !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1 !important;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.job-row-btn::after {
  border: 0;
}

/* Use flex cells so WeChat native buttons cannot overflow/overlap */
.friend-share-options {
  margin: 16rpx 0 8rpx;
  padding: 18rpx 20rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
}

.friend-share-options--compact {
  margin: 0 0 16rpx;
  background: rgba(255, 255, 255, 0.72);
}

.convert-share {
  margin: 24rpx 0 8rpx;
  padding: 24rpx 20rpx 20rpx;
  background: linear-gradient(160deg, #fff4f0 0%, #f3faf6 100%);
  border: 2rpx solid #eadfd8;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(110, 83, 94, 0.06);
}

.convert-share__head {
  margin-bottom: 14rpx;
}

.convert-share__title {
  color: #3d3438;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.convert-share__sub {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.convert-share__rewards {
  margin-bottom: 14rpx;
  padding: 14rpx 16rpx;
  background: rgba(255, 255, 255, 0.78);
  border-radius: 12rpx;
}

.convert-share__reward {
  margin-top: 8rpx;
  color: #3d6b5f;
  font-size: 22rpx;
  line-height: 1.45;
}

.convert-share__reward:first-child {
  margin-top: 0;
}

.share-action--primary {
  background: linear-gradient(135deg, #ffe8ec, #fff) !important;
  border-color: rgba(231, 109, 130, 0.35) !important;
  box-shadow: 0 8rpx 20rpx rgba(231, 109, 130, 0.12) !important;
}

.owner-share-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 16rpx 20rpx calc(env(safe-area-inset-bottom) + 16rpx);
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 249, 248, 0.96);
  border-top: 2rpx solid var(--line);
  box-shadow: 0 -10rpx 28rpx rgba(108, 80, 91, 0.06);
  box-sizing: border-box;
}

.owner-share-dock button {
  flex: 1;
  height: 84rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 84rpx;
  white-space: nowrap;
}

.owner-share-dock__share {
  background: var(--coral);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(231, 109, 130, 0.22);
}

.owner-share-dock__share::after {
  border: 0;
}

.owner-share-dock__share[disabled] {
  opacity: 0.45;
}

.owner-share-dock__save,
.owner-share-dock__home {
  background: #fff;
  border: 2rpx solid var(--line);
  color: var(--ink);
}

.owner-share-dock__save::after,
.owner-share-dock__home::after {
  border: 0;
}

.friend-share-confirm-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 28rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 28rpx);
  background: rgba(52, 49, 54, 0.45);
  box-sizing: border-box;
}

.friend-share-confirm {
  width: 100%;
  max-width: 640rpx;
  padding: 36rpx 32rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 24rpx 60rpx rgba(55, 39, 45, 0.18);
  box-sizing: border-box;
}

.friend-share-confirm__title {
  color: #3d3438;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.friend-share-confirm__desc {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.friend-share-confirm__send {
  width: 100%;
  height: 88rpx;
  margin: 28rpx 0 0;
  padding: 0;
  background: var(--coral);
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 88rpx;
  box-shadow: 0 10rpx 24rpx rgba(231, 109, 130, 0.22);
}

.friend-share-confirm__send::after {
  border: 0;
}

.friend-share-confirm__send[disabled] {
  opacity: 0.45;
}

.friend-share-confirm__send--ghost {
  margin-top: 16rpx;
  background: #fff;
  color: var(--coral);
  border: 2rpx solid rgba(231, 109, 130, 0.35);
  box-shadow: none;
}

.friend-share-confirm__cancel {
  width: 100%;
  height: 80rpx;
  margin: 12rpx 0 0;
  padding: 0;
  background: transparent;
  border: 0;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 80rpx;
}

.friend-share-confirm__cancel::after {
  border: 0;
}

.friend-share-options__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.friend-share-options__text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.friend-share-options__title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 650;
}

.friend-share-options__desc {
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.45;
}

.share-reward-panel {
  margin: 18rpx 0 10rpx;
  padding: 20rpx 20rpx 18rpx;
  background: linear-gradient(135deg, #e9f7f2 0%, #fff8f5 100%);
  border: 2rpx solid #d9eee7;
  border-radius: 14rpx;
}

.share-reward-panel__title {
  margin-bottom: 14rpx;
  color: var(--green);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.share-reward-panel__item {
  margin-top: 10rpx;
  color: #3d6b5f;
  font-size: 24rpx;
  line-height: 1.5;
}

.share-reward-panel__row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 8rpx;
}

.share-reward-panel__channel {
  flex: none;
  min-width: 120rpx;
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 650;
}

.share-reward-panel__detail {
  flex: 1;
  min-width: 0;
  color: #4a7a6c;
  font-size: 22rpx;
  line-height: 1.45;
}

.share-reward-panel__note {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 18rpx;
  line-height: 1.5;
}

.public-share-panel {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  box-shadow: 0 10rpx 26rpx rgba(108, 82, 92, 0.05);
}
.public-share-panel__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a2f2d;
}
.public-share-panel__desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted);
}
.public-share-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 28rpx;
  color: #2a2f2d;
}
.public-share-row.is-disabled {
  opacity: 0.45;
}
.public-share-panel__note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8a6b19;
  line-height: 1.45;
}
.public-share-save {
  margin-top: 20rpx;
  width: 100%;
}

.public-share-reward-tip {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  background: #fff8f0;
  border-radius: 10rpx;
  color: #9a7040;
  font-size: 22rpx;
  line-height: 1.45;
}

.avatar-panel {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  box-shadow: 0 8rpx 20rpx rgba(108, 82, 92, 0.04);
}

.avatar-panel__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.avatar-panel__text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.avatar-panel__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2a2f2d;
  line-height: 1.3;
}

.avatar-panel__desc {
  font-size: 20rpx;
  line-height: 1.35;
  color: var(--muted);
}

.avatar-make-btn {
  flex-shrink: 0;
  margin: 0;
  width: auto !important;
  min-width: 140rpx;
  height: 64rpx !important;
  padding: 0 28rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  box-shadow: 0 6rpx 14rpx rgba(231, 109, 130, 0.18);
}

.owner-flower-chip {
  margin: 8rpx 0 16rpx;
  padding: 12rpx 16rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #fff5f7;
  border: 2rpx solid #f5dbe1;
  border-radius: 999rpx;
  color: #e04b66;
  font-size: 22rpx;
  font-weight: 650;
}

.owner-flower-chip__icon {
  width: 28rpx;
  height: 28rpx;
}

.owner-flower-chip__hint {
  margin-left: 4rpx;
  padding-left: 10rpx;
  border-left: 2rpx solid #f0c8d1;
  color: #b0707c;
  font-weight: 500;
}

.author-works {
  margin-top: 28rpx;
}

.author-works__scroll {
  margin-top: 8rpx;
  width: 100%;
  white-space: nowrap;
}

.author-works__row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 2rpx 12rpx;
}

.author-works__card {
  width: 200rpx;
  flex: none;
}

.author-works__cover,
.author-works__placeholder {
  width: 200rpx;
  height: 200rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #ebe6e8;
}

.author-works__cover {
  display: block;
}

.author-works__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-family: "Kaiti SC", "STKaiti", serif;
  font-size: 30rpx;
  font-weight: 700;
}

.author-works__name {
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar-multi {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line);
}

.avatar-multi__list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.avatar-multi__item {
  min-width: 96rpx;
  padding: 14rpx 28rpx;
  background: #f6f2f3;
  border-radius: 999rpx;
  color: #5a5054;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.avatar-canvas-hidden {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 600px;
  height: 600px;
}

/* Fixed bottom dock for 花海 detail — primary create + like */
.showcase-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 249, 248, 0.96);
  border-top: 2rpx solid rgba(234, 223, 227, 0.9);
  box-shadow: 0 -12rpx 32rpx rgba(108, 82, 92, 0.08);
  backdrop-filter: blur(12px);
}

.showcase-dock__create {
  flex: 1;
  min-width: 0;
  margin: 0;
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8a0ad, #e76d82);
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 10rpx 24rpx rgba(231, 109, 130, 0.28);
}

.showcase-dock__create::after {
  border: none;
}

.showcase-dock__like,
.showcase-dock__stats {
  flex: none;
  min-width: 168rpx;
  height: 88rpx;
  padding: 0 22rpx 0 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #f0d5db;
  box-shadow: 0 8rpx 20rpx rgba(108, 82, 92, 0.06);
}

.showcase-dock__like {
  background: #fff;
}

.showcase-dock__like.is-liked {
  background: #fff5f7;
  border-color: #f2c4cd;
}

.showcase-dock__like.is-loading {
  opacity: 0.7;
}

.showcase-dock__icon {
  width: 44rpx;
  height: 44rpx;
  flex: none;
}

.showcase-dock__heart {
  width: 48rpx;
  text-align: center;
  color: #e04b66;
  font-size: 40rpx;
  line-height: 1;
}

.showcase-dock__stats-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2rpx;
}

.showcase-dock__count {
  color: #2a2f2d;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.1;
}

.showcase-dock__label {
  color: var(--muted);
  font-size: 18rpx;
  line-height: 1.1;
}

.showcase-dock__like.is-liked .showcase-dock__label {
  color: #e04b66;
}

.share-actions {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.share-action-cell {
  flex: 1;
  width: 0;
  min-width: 0;
}

.share-action {
  width: 100% !important;
  max-width: 100%;
  height: 156rpx;
  margin: 0 !important;
  padding: 14rpx 4rpx 12rpx !important;
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-sizing: border-box;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.2 !important;
  box-shadow: 0 6rpx 16rpx rgba(108, 82, 92, 0.04);
}

button.share-action {
  /* Override WeChat button defaults that cause layout collapse */
  min-height: 156rpx;
  overflow: hidden;
}

.share-action::after {
  border: 0 !important;
}

.share-action[disabled] {
  opacity: 0.45;
}

.share-action__icon {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  display: block;
}

.share-action__label {
  display: block;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.25;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.share-action__sub {
  display: block;
  width: 100%;
  color: var(--coral);
  font-size: 18rpx;
  font-weight: 650;
  line-height: 1.2;
  text-align: center;
}

.job-actions {
  margin-top: 28rpx;
}

.job-delete-wrap {
  margin-top: 16rpx;
}

.job-delete-btn {
  width: 100%;
  height: 72rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 0;
  color: #c56f60;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.job-delete-btn::after {
  border: 0;
}

.job-footer-actions {
  margin-top: 28rpx;
}

.qr-mask { position: fixed; inset: 0; z-index: 80; padding: 40rpx; display: flex; align-items: center; justify-content: center; background: rgba(52, 49, 54, .5); }
.qr-dialog { width: 560rpx; padding: 34rpx; background: #fff; border-radius: 16rpx; text-align: center; box-shadow: 0 30rpx 80rpx rgba(55, 39, 45, .2); }
.qr-title { font-size: 30rpx; font-weight: 650; }
.qr-image { width: 390rpx; height: 390rpx; margin: 24rpx auto 12rpx; display: block; }
.qr-subtitle { color: var(--muted); font-size: 22rpx; margin-bottom: 8rpx; }
.qr-save-btn { margin: 8rpx 0 16rpx; }
.result-feedback {
  margin-top: 12rpx;
  padding: 12rpx 4rpx 4rpx;
}
.result-feedback__label {
  color: var(--muted);
  font-size: 22rpx;
  margin-bottom: 10rpx;
}
.result-feedback__row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.result-feedback__chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--line);
  background: #fff;
  color: var(--muted);
  font-size: 20rpx;
}
.result-feedback__chip.is-active {
  border-color: #f2a4b1;
  background: var(--pink-soft);
  color: var(--coral);
}
.failure-panel {
  margin: 20rpx 0;
  padding: 20rpx;
  background: #fff7f5;
  border: 2rpx solid #f3d0c8;
  border-radius: 14rpx;
}
.failure-panel__title {
  font-weight: 650;
  margin-bottom: 8rpx;
}
.failure-panel__desc {
  color: var(--muted);
  font-size: 22rpx;
  margin-bottom: 12rpx;
}
.failure-row {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #a45a4c;
}
.qr-subtitle { margin-bottom: 24rpx; color: var(--muted); font-size: 20rpx; }
